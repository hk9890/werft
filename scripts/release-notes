#!/bin/sh
# Prints the CHANGELOG.md section for one version, for use as release notes.
# Exits 1 when the section is missing, so a release without an entry fails
# before it publishes. GitHub renders each line break of a release body as a
# break, so the wrapped lines of an entry are joined into one line.
set -eu

version="${1:?usage: scripts/release-notes vX.Y.Z}"
changelog="$(dirname "$0")/../CHANGELOG.md"
notes=$(awk -v h="## $version" '$0 == h {p = 1; next} /^## / {p = 0} p' "$changelog" |
	awk 'function flush() { if (have) print buf; have = 0 }
		/^ +[^ ]/ && have && buf != "" { sub(/^ +/, ""); buf = buf " " $0; next }
		{ flush(); buf = $0; have = 1 }
		END { flush() }')
if [ -z "$notes" ]; then
	echo "CHANGELOG.md has no section '## $version'" >&2
	exit 1
fi
printf '%s\n' "$notes"
